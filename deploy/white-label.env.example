# Шаблон одного отдельного экземпляра. Значения ниже вымышленные.
# Подключение к БД, файлы и SMTP настраиваются отдельно для экземпляра.
WHITE_LABEL_ENABLED=True
WHITE_LABEL_PROGRAM_ID=1
WHITE_LABEL_BRAND_NAME=Кейс-чемпионат клиента
WHITE_LABEL_LOGO_URL=https://championship.example.test/logo.svg
WHITE_LABEL_FAVICON_URL=
WHITE_LABEL_LOGO_BACKGROUND=transparent
WHITE_LABEL_FRONTEND_URL=https://championship.example.test
WHITE_LABEL_API_HOST=api.championship.example.test
# Сессионные cookies интерфейса принадлежат текущему frontend-host.
# Демо-наполнение не разрешается в клиентской/боевой среде.
WHITE_LABEL_DEMO_ALLOWED=False
EXPERT_WORKSPACE_FRONTEND_URL=https://championship.example.test
DATABASE_NAME=client_championship
DATABASE_USER=client_championship
DATABASE_PASSWORD=replace-with-instance-password
DATABASE_HOST=replace-with-instance-database-host
DATABASE_PORT=5432
EMAIL_USER=no-reply@championship.example.test
