root @@ROOT@@/frontend;
index index.html;
server_tokens off;
client_max_body_size 100m;
auth_basic $ppv2_realm;
auth_basic_user_file @@ROOT@@/access.htpasswd;
add_header Set-Cookie $ppv2_gate_cookie;
add_header X-Robots-Tag "noindex, nofollow" always;
add_header X-Content-Type-Options nosniff always;
add_header Cache-Control "private, no-store" always;

location = /admin { return 302 /backend/admin/; }
location = /admin/ { return 302 /backend/admin/; }
location /backend/media/ {
    alias @@ROOT@@/data/media/;
    add_header Content-Disposition attachment;
    add_header X-Content-Type-Options nosniff always;
}
location /backend/static/ { alias @@ROOT@@/data/static/; }
location /backend/ {
    proxy_pass http://127.0.0.1:18319;
    proxy_set_header Daphne-Root-Path /backend;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Authorization $ppv2_authorization;
    proxy_read_timeout 120s;
}
location /ws {
    proxy_pass http://127.0.0.1:18319;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $ppv2_authorization;
    proxy_read_timeout 600s;
}
location /brand/ { alias @@ROOT@@/brand/; }
location / { try_files $uri $uri/ /index.html; }
